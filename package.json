{
  "name": "base-case",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "description": "Local-first coding interview and system design practice.",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @base-case/desktop dev",
    "dev:inspect": "pnpm --filter @base-case/desktop dev:inspect",
    "build": "pnpm --filter @base-case/desktop build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && pnpm judge:test",
    "judge:build": "node scripts/build-judge.mjs",
    "judge:test": "go test -C services/judge ./...",
    "judge:vet": "go vet -C services/judge ./...",
    "runtimes:fetch": "node scripts/fetch-runtimes.mjs",
    "runtimes:verify": "node scripts/fetch-runtimes.mjs --verify",
    "content:validate": "pnpm content:validate:core && pnpm content:validate:optional",
    "content:validate:core": "tsx packages/content-cli/src/cli.ts validate content/packs/core",
    "content:validate:optional": "tsx packages/content-cli/src/cli.ts validate content/packs/neetcode150",
    "content:test": "pnpm content:test:core && pnpm content:test:optional",
    "content:test:core": "tsx packages/content-cli/src/cli.ts test content/packs/core",
    "content:test:optional": "tsx packages/content-cli/src/cli.ts test content/packs/neetcode150",
    "mermaid:check": "node scripts/check-mermaid.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "package:win": "node scripts/fetch-runtimes.mjs && node scripts/build-judge.mjs && pnpm --filter @base-case/desktop package:win",
    "release:checksums": "node scripts/checksums.mjs apps/desktop/dist",
    "smoke:e2e": "node scripts/smoke-electron.mjs",
    "smoke:playwright": "pnpm --filter @base-case/desktop build && pnpm --filter @base-case/desktop test:e2e",
    "demo:record": "node scripts/record-demo.mjs",
    "evals": "tsx scripts/ai-evals.ts",
    "review:evals": "tsx scripts/review-ai-evals.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "mermaid": "^11.17.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
