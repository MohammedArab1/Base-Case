{
  "schemaVersion": 1,
  "id": "core/note-check",
  "slug": "note-check",
  "title": "Note Check",
  "difficulty": "easy",
  "patterns": ["strings", "hash-map"],
  "statement": "statement.md",
  "signature": {
    "kind": "function",
    "className": "Solution",
    "method": "canCompose",
    "params": [
      {
        "name": "note",
        "type": "string"
      },
      {
        "name": "source",
        "type": "string"
      }
    ],
    "returns": "boolean",
    "mutates": []
  },
  "limits": {
    "timeMs": 2000,
    "memoryMb": 256,
    "languageMultipliers": {
      "python": 3,
      "javascript": 3,
      "typescript": 3
    }
  },
  "checker": {
    "kind": "exact"
  },
  "tests": {
    "sample": "tests/sample.jsonl",
    "hidden": "tests/hidden.jsonl"
  },
  "hints": "hints.json",
  "solutions": [
    {
      "language": "python",
      "path": "solutions/python.py",
      "time": "O(n + m)",
      "space": "O(1)",
      "isCanonical": true
    },
    {
      "language": "typescript",
      "path": "solutions/typescript.ts",
      "time": "O(n + m)",
      "space": "O(1)"
    }
  ],
  "explanation": "explanation.md",
  "commonMistakes": [
    "Reusing letters",
    "Forgetting the length shortcut",
    "Ignoring letter frequencies"
  ],
  "followUps": [
    "What if the source could be reused after a delay?",
    "How would you handle Unicode letters?"
  ],
